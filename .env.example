# Copy to .env and fill in. Values below are the PRODUCTION-safe defaults —
# for local development set APP_ENV=local, APP_DEBUG=true, SESSION_SECURE_COOKIE=false.

APP_NAME="CreatorPro"
APP_ENV=production
APP_KEY=
# Never true in production: stack traces leak env values and secrets.
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digitalselling
DB_USERNAME=
DB_PASSWORD=

# Sessions live in the DB (Settings → Security lists them and can log other devices out).
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads and send the cookie over HTTPS only.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Login OTP, new-device alerts and booking emails go through this mailer.
MAIL_MAILER=smtp
# MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=support@magadhtechnologies.com
MAIL_PASSWORD=k1@LchEB5
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=support@magadhtechnologies.com
MAIL_FROM_NAME="${APP_NAME}"




AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Razorpay - Pro plan billing (test keys: rzp_test_...). Webhook URL: /webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLUS_PLAN_ID=

# Platform details printed on Pro plan tax invoices (prices are GST-inclusive)
BILLING_SELLER_NAME="${APP_NAME}"
BILLING_SELLER_LEGAL_NAME=
BILLING_SELLER_GSTIN=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_STATE=
BILLING_SELLER_EMAIL=
BILLING_GST_RATE=18
BILLING_SAC_CODE=

# Customer portal mobile login (SMS OTP). log = write the code to storage/logs (local only); msg91 = send via MSG91
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
